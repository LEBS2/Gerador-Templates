# Copie este arquivo para .env e preencha com valores reais
# NUNCA commite o .env no repositório

# Credenciais de admin (obrigatório)
ADMIN_USER=seu_usuario_admin
ADMIN_PASS=sua_senha_forte

# Segredo para assinatura HMAC das sessões (mínimo 32 chars aleatórios)
SESSION_SECRET=troque-por-string-aleatoria-de-minimo-32-caracteres

# Vercel KV - necessário em produção (deixe em branco para modo dev com memória)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Porta do servidor (padrão: 3000)
PORT=3000

# Encaminhamento de notificações para o Telegram (opcional - se deixar em
# branco, o envio fica desativado e o resto do app funciona normalmente).
# TELEGRAM_API_ID e TELEGRAM_API_HASH: pegue em https://my.telegram.org
# TELEGRAM_SESSION: gere rodando "npm run telegram:login" (login local, uma
#   vez só, com o número de telefone da conta) - veja scripts/telegram-login.js
# TELEGRAM_CHAT_ID: ID numérico (ex: -1001234567890) ou @username do
#   grupo/canal que vai receber as notificações - a conta logada precisa ser
#   membro dele
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_CHAT_ID=
